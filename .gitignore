# Ignorar variáveis de ambiente
.env
*.env.*

# Ignorar arquivos temporários
/tmp.git
*.tmp*
.DS_Store
Thumbs.db
repomix-*.xml
*.bak
*.bin
*.old
*.swp
*.tar
*.wav
*.log

# Ignorar artefatos do Rust
#Cargo.lock
/target

# Ignorar diretório de scratch (artefatos de debug/protótipos temporários)
scratch/
scratch
scratch.rs

# Binários e scripts de debug compilados ad-hoc na raiz
/test_*
!/tests/

# Golden vectors de validação numérica (não ignorar)
!tests/fixtures/*.bin
!tests/golden/*.bin

# Proptest regression files (gerados automaticamente)
*.proptest-regressions

# Espelho dos projetos de referência no GitHub
/github.com/

# Fuzzing (cargo-fuzz)
# Mantemos apenas os targets e a configuração. Ignoramos o corpus evoluído e artefatos de crash.
fuzz/target/
fuzz/artifacts/
fuzz/corpus/
fuzz/Cargo.lock

# Artefatos do cargo-mutants
.mutants/
.out/
mutants.out.old/